# Copy to .env and adjust
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=tourism_recsys
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
AUTH_RATE_LIMIT=50

# public website URL (used in the verification e-mail link)
APP_URL=http://localhost:3000
# SMTP for verification e-mails; without SMTP_HOST the code is shown in the UI (demo delivery)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
# MAIL_FROM="Wayfarer <you@gmail.com>"
# EMAIL_DEMO_MODE=false
# recommendation engine
CF_MODEL_TTL_MINUTES=60
REC_CACHE_TTL_SECONDS=600
