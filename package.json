{
  "name": "databank",
  "version": "1.0.0",
  "description": "NoSQL (MongoDB) tourism recommendation platform: REST API, collaborative filtering, web UI",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "recompute": "node scripts/recompute-stats.js",
    "explain": "node scripts/explain.js",
    "inspect-db": "node scripts/inspect-db.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 test/api.test.js",
    "indexes": "node scripts/create-indexes.js",
    "backfill-favorites": "node scripts/backfill-favorites.js",
    "build-model": "node scripts/build-model.js",
    "evaluate": "node scripts/evaluate.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.22.0",
    "nodemailer": "^6.10.1",
    "zod": "^4.6.7"
  },
  "private": true
}
